[resource]
script = ExtResource("1_mission")
id = &"nonna_rosa_spy"
title = "Industrial Espionage"
customer_name = "Nonna Rosa (Nonna Pina's rival)"
request_text = "Bring me HER pizza. I need to know her secret. Tell no one, especially not her."
pickup_location_id = &"pizzeria"
dropoff_location_id = &"address_3"
cargo = ExtResource("2_cargo")
