[resource]
script = ExtResource("1_mission")
id = &"mayor_espresso"
title = "Council Coffee"
customer_name = "Don Peppino, the mayor"
request_text = "Six espressos for the town council. Spill one drop and there's a fine. I am the fine."
pickup_location_id = &"pizzeria"
dropoff_location_id = &"address_6"
cargo = ExtResource("2_cargo")
base_payout = 12
max_tip = 10
success_line = "Not a drop spilled. You may park anywhere for a week. Except there."
late_line = "The council fell asleep. This is now a scandal."
ruined_line = "That is a puddle with ambition. Fined."
