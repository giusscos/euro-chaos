[ext_resource type="Script" path="res://core/missions/mission_data.gd" id="1_mission"]
[ext_resource type="Resource" path="res://minigames/vespa_delivery/data/cargo/pizza.tres" id="2_cargo"]

[resource]
script = ExtResource("1_mission")
id = &"cruise_couple"
title = "Authentic Experience"
customer_name = "Mr. and Mrs. Thompson (cruise ship, 40 min ashore)"
request_text = "We want something really authentic. Do you have ketchup? And ranch? Our ship leaves in 40 minutes."
pickup_location_id = &"pizzeria"
dropoff_location_id = &"address_2"
cargo = ExtResource("2_cargo")
base_payout = 12
max_tip = 8
success_line = "Wow, so authentic! Honey, take a picture of the delivery boy."
late_line = "We'll have to eat it on the ship. Next to the buffet. Sad."
ruined_line = "Is it supposed to look like that? Is that a local thing?"
