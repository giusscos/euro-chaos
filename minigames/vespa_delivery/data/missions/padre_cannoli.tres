[ext_resource type="Resource" path="res://minigames/vespa_delivery/data/cargo/cannoli.tres" id="2_cargo"]

[resource]
script = ExtResource("1_mission")
id = &"padre_cannoli"
title = "For the Choir"
customer_name = "Padre Anselmo"
request_text = "A dozen cannoli. For the choir. Purely for the choir. Bless you, my child."
pickup_location_id = &"pizzeria"
dropoff_location_id = &"address_1"
cargo = ExtResource("2_cargo")
base_payout = 8
max_tip = 8
success_line = "The choir thanks you. Especially the soprano, who is me."
late_line = "The choir sang hungry. It was not their best Ave Maria."
ruined_line = "Forgive them, for they were cannoli."
