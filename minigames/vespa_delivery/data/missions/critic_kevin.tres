[resource]
script = ExtResource("1_mission")
id = &"critic_kevin"
title = "The Review"
customer_name = "Kevin (food critic, 3 followers)"
request_text = "I'll be rating the pizza, the delivery, and your posture. Mostly your posture."
pickup_location_id = &"pizzeria"
dropoff_location_id = &"address_4"
cargo = ExtResource("2_cargo")
